# Environment Variables - COPY THIS TO .env AND FILL IN VALUES
# NEVER commit .env to version control

# AVVNL API Credentials (MSR Pay)
AVVNL_USERNAME=R5296890
AVVNL_API_KEY=

# Server Configuration
PORT=3000
NODE_ENV=development

# API Base URL
AVVNL_API_BASE=https://www.bijlimitraavvnl.com/api

# CORS allowed origins (comma-separated for production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Request timeout in milliseconds
API_TIMEOUT=15000

# Rate limiting: max requests per 15 minutes per IP
RATE_LIMIT_MAX=30
